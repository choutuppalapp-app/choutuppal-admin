generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String?
  phone       String?
  address     String?
  villageId   String?
  category    String?
  images      Json?
  createdAt   DateTime @default(now())
}

model RealEstate {
  id        String   @id @default(uuid())
  title     String
  type      RealEstateType
  price     Float?
  location  String?
  size      String?
  images    Json?
  createdAt DateTime @default(now())
}

enum RealEstateType {
  PLOT
  HOUSE
}

model Village {
  id         String   @id @default(uuid())
  name       String
  mandal     String?
  population Int?
  details    String?
  createdAt  DateTime @default(now())
}

model Category {
  id        String       @id @default(uuid())
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())
}

enum CategoryType {
  BLOG
  NEWS
  LISTING
}

model Post {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String?
  excerpt        String?
  imageUrl       String?
  categoryId     String?
  type           PostType
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
}

enum PostType {
  BLOG
  NEWS
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Story {
  id        String    @id @default(uuid())
  title     String
  mediaUrl  String
  mediaType MediaType
  link      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}
